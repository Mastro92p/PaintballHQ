generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model League {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  logoUrl     String?
  createdAt   DateTime     @default(now())

  isHidden    Boolean  @default(false)

  teams       LeagueTeam[]
  tournaments Tournament[]
  manualStandingTables LeagueManualStandingTable[]
}

model LeagueTeam {
  leagueId Int
  teamId   Int
  joinedAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([leagueId, teamId])
}

model Division {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  teams       Team[]
  tournaments Tournament[]
  manualStandingTables LeagueManualStandingTable[]
}

model Tournament {
  id             Int      @id @default(autoincrement())
  name           String
  date           String
  startDateTime  DateTime?
  location       String
  status         String   @default("upcoming")
  createdAt      DateTime @default(now())
  leagueId       Int?
  teamsToAdvance Int      @default(4)
  type           String   @default("round_robin")
  formatConfig   Json?
  divisionId     Int?
  managementMode String   @default("auto")

  isHidden    Boolean  @default(false)

  matches            Match[]
  division           Division? @relation(fields: [divisionId], references: [id])
  league             League?   @relation(fields: [leagueId], references: [id])
  groups             TournamentGroup[]
  teams              TournamentTeam[]
  brackets           TournamentBracket[]
  manualStandingDays LeagueManualStandingDay[]

  @@index([startDateTime])
}

model Team {
  id         Int      @id @default(autoincrement())
  name       String
  contact    String?
  createdAt  DateTime @default(now())
  logoUrl    String?
  divisionId Int?

  leagues     LeagueTeam[]
  matchesA    Match[] @relation("TeamA")
  matchesB    Match[] @relation("TeamB")
  division    Division? @relation(fields: [divisionId], references: [id])
  tournaments TournamentTeam[]
  manualStandingScores LeagueManualStandingScore[]
}

model TournamentTeam {
  tournamentId Int
  teamId       Int
  groups       String[] @default([])

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupLinks TournamentTeamGroup[]

  @@id([tournamentId, teamId])
}

model TournamentBracket {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  name         String
  sortOrder    Int
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    Match[]

  @@unique([tournamentId, name])
  @@index([tournamentId, sortOrder])
}

model Match {
  id               Int      @id @default(autoincrement())
  tournamentId     Int
  teamAId          Int?
  teamBId          Int?
  scoreA           Int?
  scoreB           Int?
  round            Int?
  field            String?
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  manualOverride   Boolean  @default(false)
  phase            String   @default("group")
  groupLegacy      String?  @map("group")
  bracketOrder     Int?
  nextMatchOrder   Int?
  nextSlot         String?
  nextMatchId      Int?
  loserNextMatchId Int?
  loserNextSlot    String?
  bodyCountA       Int?
  bodyCountB       Int?
  label            String?
  groupId          Int?
  bracketId        Int?

  group      TournamentGroup?   @relation(fields: [groupId], references: [id])
  bracket    TournamentBracket? @relation(fields: [bracketId], references: [id], onDelete: SetNull)
  nextMatch  Match?             @relation("MatchProgression", fields: [nextMatchId], references: [id])
  prevMatches Match[]           @relation("MatchProgression")
  teamA      Team?              @relation("TeamA", fields: [teamAId], references: [id])
  teamB      Team?              @relation("TeamB", fields: [teamBId], references: [id])
  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([bracketId])
  @@index([tournamentId, phase])
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("organizer")
  createdAt DateTime @default(now())
}

model TournamentGroup {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  name         String
  order        Int
  createdAt    DateTime @default(now())

  matches    Match[]
  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamGroups TournamentTeamGroup[]

  @@unique([tournamentId, name])
  @@index([tournamentId, order])
}

model TournamentTeamGroup {
  tournamentId Int
  teamId       Int
  groupId      Int

  group          TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tournamentTeam TournamentTeam  @relation(fields: [tournamentId, teamId], references: [tournamentId, teamId], onDelete: Cascade)

  @@id([tournamentId, teamId, groupId])
}

model LeagueManualStandingTable {
  id         Int    @id @default(autoincrement())
  leagueId   Int
  divisionId Int

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  days       LeagueManualStandingDay[]

  @@unique([leagueId, divisionId])
  @@index([leagueId])
  @@index([divisionId])
}

model LeagueManualStandingDay {
  id           Int                       @id @default(autoincrement())
  tableId       Int
  tournamentId  Int
  label         String
  date          String
  sortOrder     Int
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  table         LeagueManualStandingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tournament    Tournament                @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  scores        LeagueManualStandingScore[]

  @@unique([tableId, tournamentId])
}

model LeagueManualStandingScore {
  id         Int  @id @default(autoincrement())
  dayId       Int
  teamId      Int
  score       Int?
  eventRank   Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  day         LeagueManualStandingDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  team        Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([dayId, teamId])
  @@index([teamId])
}