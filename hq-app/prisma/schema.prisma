generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model League {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  logoUrl     String?
  createdAt   DateTime     @default(now())

  tournaments Tournament[]
  teams       LeagueTeam[]
}

model LeagueTeam {
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId   Int
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     Int
  joinedAt   DateTime @default(now())

  @@id([leagueId, teamId])
}


model Division {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  teams       Team[]
  tournaments Tournament[]
}


model Tournament {
  id             Int      @id @default(autoincrement())
  name           String
  date           String
  location       String
  status         String   @default("upcoming")
  type           String   @default("round_robin")
  teamsToAdvance Int      @default(4)
  formatConfig   Json?
  createdAt      DateTime @default(now())

  managementMode String @default("auto") // "auto" | "manual"

  leagueId       Int?
  league         League?  @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  divisionId     Int?
  division       Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  teams          TournamentTeam[]
  matches        Match[]
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String?
  logoUrl     String?
  createdAt   DateTime @default(now())

  divisionId  Int?
  division    Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  leagues     LeagueTeam[]
  tournaments TournamentTeam[]
  matchesA    Match[]          @relation("TeamA")
  matchesB    Match[]          @relation("TeamB")
}

model TournamentTeam {
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId Int
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       Int
  groups       String[] @default([])

  @@id([tournamentId, teamId])
}

model Match {
  id           Int        @id @default(autoincrement())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId Int
  teamA        Team?      @relation("TeamA", fields: [teamAId], references: [id])
  teamAId      Int?
  teamB        Team?      @relation("TeamB", fields: [teamBId], references: [id])
  teamBId      Int?
  scoreA       Int?
  scoreB       Int?
  round        Int?
  label        String?
  phase        String     @default("group")
  group        String?
  field        String?

  nextMatchId      Int?
  nextMatch        Match?  @relation("MatchProgression", fields: [nextMatchId], references: [id])
  prevMatches      Match[] @relation("MatchProgression")

  loserNextMatchId Int?
  loserNextSlot    String?

  bracketOrder     Int?
  nextMatchOrder   Int?
  nextSlot         String?

  status           String   @default("pending")
  manualOverride   Boolean  @default(false)
  createdAt        DateTime @default(now())

  bodyCountA       Int?
  bodyCountB       Int?
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("organizer")
  createdAt DateTime @default(now())
}